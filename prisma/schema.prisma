generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LeadStatus {
  NEW
  QUALIFIED
  IN_PROGRESS
  DEAD
}

enum LeadSource {
  CONTACT_FORM
}

enum ServiceInterest {
  GOOGLE_ADS
  SEO
  WEB_DEVELOPMENT
  MOBILE_APP_DEVELOPMENT
  GENERAL_MARKETING
  OTHER
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  MANAGER
  MEMBER
}

enum ProjectCurrency {
  USD
  AED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String       @id @default(cuid()) @db.VarChar(36)
  name          String
  email         String       @unique @db.VarChar(255)
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[] @relation("InvitationInviter")
  teamMembers   TeamMember[]

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid()) @db.VarChar(36)
  expiresAt            DateTime
  token                String   @unique @db.VarChar(255)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.VarChar(36)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @db.VarChar(36)
  activeTeamId         String?  @db.VarChar(36)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid()) @db.VarChar(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String    @db.VarChar(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid()) @db.VarChar(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String             @id @default(cuid()) @db.VarChar(36)
  name        String
  slug        String             @unique
  logo        String?
  metadata    String?            @db.Text
  createdAt   DateTime           @default(now())
  members     Member[]
  invitations Invitation[]
  teams       Team[]
  roles       OrganizationRole[]

  @@map("organization")
}

model Member {
  id                     String                  @id @default(cuid()) @db.VarChar(36)
  userId                 String                  @db.VarChar(36)
  organizationId         String                  @db.VarChar(36)
  role                   String
  createdAt              DateTime                @default(now())
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                 Client?
  serviceRequestMessages ServiceRequestMessage[]
  createdProjects        Project[]               @relation("ProjectCreator")
  memberProjects         MemberProject[]
  createdTasks           Task[]                  @relation("TaskCreator")
  taskAssignees          TaskAssignee[]

  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id              String       @id @default(cuid()) @db.VarChar(36)
  email           String
  inviterId       String       @db.VarChar(36)
  organizationId  String       @db.VarChar(36)
  role            String?
  serviceInterest String?      @db.VarChar(64)
  status          String
  teamId          String?      @db.VarChar(36)
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
  inviter         User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([inviterId])
  @@index([organizationId])
  @@map("invitation")
}

model Team {
  id             String       @id @default(cuid()) @db.VarChar(36)
  name           String
  organizationId String       @db.VarChar(36)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String   @id @default(cuid()) @db.VarChar(36)
  teamId    String   @db.VarChar(36)
  userId    String   @db.VarChar(36)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model OrganizationRole {
  id             String       @id @default(cuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  role           String
  permission     String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organizationRole")
}

model Client {
  id        String           @id @default(cuid()) @db.VarChar(36)
  memberId  String           @unique @db.VarChar(36)
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requests  ServiceRequest[]
  projects  Project[]

  @@map("clients")
}

model ServiceRequest {
  id        String                  @id @default(cuid()) @db.VarChar(36)
  clientId  String                  @db.VarChar(36)
  service   ServiceInterest
  status    ServiceRequestStatus    @default(NEW)
  data      Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  client    Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages  ServiceRequestMessage[]
  project   Project?

  @@index([clientId])
  @@index([service])
  @@index([status])
  @@map("serviceRequests")
}

model Project {
  id                String          @id @default(cuid()) @db.VarChar(36)
  clientId          String          @db.VarChar(36)
  serviceRequestId  String?         @unique @db.VarChar(36)
  createdByMemberId String          @db.VarChar(36)
  name              String
  description       String?         @db.Text
  service           ServiceInterest
  status            ProjectStatus   @default(PLANNING)
  startDate         DateTime?
  endDate           DateTime?
  budgetAmount      Decimal?        @db.Decimal(12, 2)
  currency          ProjectCurrency @default(USD)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceRequest    ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  createdBy         Member          @relation("ProjectCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  memberProjects    MemberProject[]
  tasks             Task[]
  taskAssignees     TaskAssignee[]

  @@index([clientId])
  @@index([createdByMemberId])
  @@index([service])
  @@index([status])
  @@map("projects")
}

model Task {
  id                String         @id @default(cuid()) @db.VarChar(36)
  projectId         String         @db.VarChar(36)
  createdByMemberId String         @db.VarChar(36)
  title             String
  description       String?        @db.Text
  status            TaskStatus     @default(TODO)
  priority          TaskPriority   @default(MEDIUM)
  dueDate           DateTime?
  estimatedHours    Decimal?       @db.Decimal(8, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         Member         @relation("TaskCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  assignees         TaskAssignee[]

  @@index([projectId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

model TaskAssignee {
  id        String   @id @default(cuid()) @db.VarChar(36)
  taskId    String   @db.VarChar(36)
  projectId String   @db.VarChar(36)
  memberId  String   @db.VarChar(36)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@map("taskAssignees")
}

model MemberProject {
  id        String            @id @default(cuid()) @db.VarChar(36)
  projectId String            @db.VarChar(36)
  memberId  String            @db.VarChar(36)
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
  @@index([role])
  @@map("memberProjects")
}

model ServiceRequestMessage {
  id               String         @id @default(cuid()) @db.VarChar(36)
  serviceRequestId String         @db.VarChar(36)
  authorMemberId   String         @db.VarChar(36)
  body             String         @db.Text
  isInternal       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  author           Member         @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@index([authorMemberId])
  @@map("serviceRequestMessages")
}

model Lead {
  id              String          @id @default(cuid())
  name            String
  email           String
  companyName     String?
  serviceInterest ServiceInterest
  budgetRange     String?
  status          LeadStatus      @default(NEW)
  source          LeadSource      @default(CONTACT_FORM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([serviceInterest])
  @@map("leads")
}
