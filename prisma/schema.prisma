generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LeadStatus {
  NEW
  QUALIFIED
  IN_PROGRESS
  DEAD
}

enum LeadSource {
  CONTACT_FORM
}

enum ServiceInterest {
  GOOGLE_ADS
  SEO
  WEB_DEVELOPMENT
  MOBILE_APP_DEVELOPMENT
  GENERAL_MARKETING
  OTHER
}

enum ServiceRequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  MANAGER
  MEMBER
}

enum ProjectCurrency {
  USD
  AED
}

enum MediaTargetType {
  PROJECT
  TASK
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
}

enum ProposalPaymentStatus {
  UNPAID
  PAID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String       @id @default(cuid()) @db.VarChar(36)
  name          String
  email         String       @unique @db.VarChar(255)
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[] @relation("InvitationInviter")

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid()) @db.VarChar(36)
  expiresAt            DateTime
  token                String   @unique @db.VarChar(255)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.VarChar(36)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @db.VarChar(36)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid()) @db.VarChar(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String    @db.VarChar(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid()) @db.VarChar(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String             @id @default(cuid()) @db.VarChar(36)
  name        String
  slug        String             @unique
  logo        String?
  metadata    String?            @db.Text
  createdAt   DateTime           @default(now())
  members     Member[]
  invitations Invitation[]
  roles       OrganizationRole[]

  @@map("organization")
}

model Member {
  id               String          @id @default(cuid()) @db.VarChar(36)
  userId           String          @db.VarChar(36)
  organizationId   String          @db.VarChar(36)
  role             String
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client?
  createdProposals Proposal[]      @relation("ProposalCreator")
  createdProjects  Project[]       @relation("ProjectCreator")
  memberProjects   MemberProject[]
  createdTasks     Task[]          @relation("TaskCreator")
  taskAssignees    TaskAssignee[]
  taskComments     TaskComment[]
  notifications    Notification[]

  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Notification {
  id        String    @id @default(cuid()) @db.VarChar(36)
  memberId  String    @db.VarChar(36)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  link      String?   @db.VarChar(2048)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, readAt, createdAt])
  @@map("notifications")
}

model Invitation {
  id              String       @id @default(cuid()) @db.VarChar(36)
  email           String
  inviterId       String       @db.VarChar(36)
  organizationId  String       @db.VarChar(36)
  role            String?
  serviceInterest String?      @db.VarChar(64)
  status          String
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
  inviter         User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([inviterId])
  @@index([organizationId])
  @@map("invitation")
}

model OrganizationRole {
  id             String       @id @default(cuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  role           String
  permission     String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organizationRole")
}

model Client {
  id               String           @id @default(cuid()) @db.VarChar(36)
  memberId         String           @unique @db.VarChar(36)
  stripeCustomerId String?          @unique @db.VarChar(255)
  name             String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  member           Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requests         ServiceRequest[]
  projects         Project[]

  @@map("clients")
}

model ServiceRequest {
  id        String               @id @default(cuid()) @db.VarChar(36)
  clientId  String               @db.VarChar(36)
  service   ServiceInterest
  status    ServiceRequestStatus @default(NEW)
  data      Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal  Proposal?
  project   Project?

  @@index([clientId])
  @@index([service])
  @@index([status])
  @@map("serviceRequests")
}

model Proposal {
  id                     String                @id @default(cuid()) @db.VarChar(36)
  serviceRequestId       String                @unique @db.VarChar(36)
  createdByMemberId      String                @db.VarChar(36)
  description            String                @db.Text
  amount                 Decimal               @db.Decimal(12, 2)
  currency               ProjectCurrency
  status                 ProposalStatus        @default(DRAFT)
  paymentStatus          ProposalPaymentStatus @default(UNPAID)
  acceptedAt             DateTime?
  paidAt                 DateTime?
  stripeInvoiceId        String?               @unique @db.VarChar(255)
  stripeInvoiceNumber    String?               @db.VarChar(255)
  stripeHostedInvoiceUrl String?               @db.Text
  stripeInvoicePdfUrl    String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  serviceRequest         ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  createdBy              Member                @relation("ProposalCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  @@index([createdByMemberId])
  @@index([status])
  @@index([paymentStatus])
  @@map("proposals")
}

model Project {
  id                String          @id @default(cuid()) @db.VarChar(36)
  clientId          String          @db.VarChar(36)
  serviceRequestId  String?         @unique @db.VarChar(36)
  createdByMemberId String          @db.VarChar(36)
  name              String
  description       String?         @db.Text
  service           ServiceInterest
  status            ProjectStatus   @default(PLANNING)
  startDate         DateTime?
  endDate           DateTime?
  budgetAmount      Decimal?        @db.Decimal(12, 2)
  currency          ProjectCurrency @default(USD)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceRequest    ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  createdBy         Member          @relation("ProjectCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  memberProjects    MemberProject[]
  tasks             Task[]
  taskAssignees     TaskAssignee[]
  addOnTasks        AddOnTask[]

  @@index([clientId])
  @@index([createdByMemberId])
  @@index([service])
  @@index([status])
  @@map("projects")
}

model Media {
  id           String          @id @default(cuid()) @db.VarChar(36)
  targetType   MediaTargetType
  targetId     String          @db.VarChar(36)
  publicId     String          @unique @db.VarChar(255)
  secureUrl    String          @db.Text
  resourceType String          @db.VarChar(16)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([targetType, targetId, createdAt])
  @@map("media")
}

model Task {
  id                String         @id @default(cuid()) @db.VarChar(36)
  projectId         String         @db.VarChar(36)
  createdByMemberId String         @db.VarChar(36)
  title             String
  description       String?        @db.Text
  status            TaskStatus     @default(TODO)
  priority          TaskPriority   @default(MEDIUM)
  dueDate           DateTime?
  estimatedHours    Decimal?       @db.Decimal(8, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         Member         @relation("TaskCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  assignees         TaskAssignee[]
  addOnTasks        AddOnTask[]
  comments          TaskComment[]

  @@index([projectId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid()) @db.VarChar(36)
  taskId    String   @db.VarChar(36)
  memberId  String?  @db.VarChar(36)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([memberId])
  @@map("taskComments")
}

model AddOnTask {
  id          String   @id @default(cuid()) @db.VarChar(36)
  taskId      String   @db.VarChar(36)
  projectId   String   @db.VarChar(36)
  name        String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@map("addOnTasks")
}

model TaskAssignee {
  id        String   @id @default(cuid()) @db.VarChar(36)
  taskId    String   @db.VarChar(36)
  projectId String   @db.VarChar(36)
  memberId  String   @db.VarChar(36)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([projectId])
  @@index([memberId])
  @@map("taskAssignees")
}

model MemberProject {
  id        String            @id @default(cuid()) @db.VarChar(36)
  projectId String            @db.VarChar(36)
  memberId  String            @db.VarChar(36)
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
  @@index([role])
  @@map("memberProjects")
}

model ChatHistory {
  id          String   @id @default(cuid()) @db.VarChar(36)
  channelType String   @db.VarChar(32)
  channelId   String   @db.VarChar(36)
  messages    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelType, channelId])
  @@index([expiresAt])
  @@map("chatHistories")
}

model Lead {
  id              String          @id @default(cuid())
  name            String
  email           String
  companyName     String?
  serviceInterest ServiceInterest
  budgetRange     String?
  status          LeadStatus      @default(NEW)
  source          LeadSource      @default(CONTACT_FORM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([serviceInterest])
  @@map("leads")
}
